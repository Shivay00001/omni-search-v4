# ── Omni Search V4 ─────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# The backend works without any key: it falls back through keyless providers
# (Pollinations -> g4f). Keys below unlock extra providers.

# Server
PORT=8000

# Database (sqlite by default; override for Postgres)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/omni

# ── AI providers (all optional) ──────────────────────────────────────────
# Puter — get a token at https://puter.com/dashboard -> Create token
PUTER_API_TOKEN=
# PUTER_MODEL=gpt-5.4-nano

# Groq — free tier at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — free models at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# (also powers: Nemotron 3.5 free, GLM 5.3 Flash, Qwen3.8 Flash, Muse Spark)

# LLM7 — free key at https://dash.llm7.io/#/api-keys
LLM7_API_KEY=
# LLM7_MODEL=gemini-3.1-flash-lite

# Gemini — free tier at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# DeepSeek — free trial credits for new accounts at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# UnoRouter — free key at https://unorouter.com (free lanes: GLM 5.3, DeepSeek, Qwen…)
UNOROUTER_API_KEY=
# UNOROUTER_MODEL=glm-5.3:free

# Overrides for keyless providers (defaults work out of the box)
# POLLINATIONS_MODEL=openai
