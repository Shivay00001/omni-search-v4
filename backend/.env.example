# ── Omni Search V4 ─────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# The backend works without any key: it falls back to free g4f providers.

# Optional: enables the Gemini fallback tier in the Sentinel provider
GEMINI_API_KEY=your-gemini-key

# Server
PORT=8000

# Database (sqlite by default; override for Postgres)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/omni
